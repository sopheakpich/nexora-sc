{
  "project": {
    "name": "Nexora SC — HeyGen Ad Video",
    "description": "Professional Video Ad Production Guide",
    "platform": "HeyGen AI Video Generator",
    "format": "60–90 second promotional ad",
    "goal": "Drive registrations for a video editing skills training event",
    "version": "1.0.0",
    "created": "2026-05-25"
  },

  "master_prompt": {
    "target_field": "HeyGen Script or AI Script Generator",
    "text": "Create a professional, high-energy promotional video ad for a Video Editing Masterclass training event. The tone is motivating, modern, and aspirational. The avatar presenter is confident, well-dressed, and speaks directly to aspiring content creators and marketing professionals. Background is a sleek dark studio with subtle animated light accents. The video runs 60–90 seconds. Use dynamic text overlays, smooth scene transitions, and upbeat background music. Include a clear call-to-action at the end to register now."
  },

  "script": {
    "total_duration_seconds": 80,
    "scenes": [
      {
        "id": 1,
        "label": "HOOK",
        "time_start": "0:00",
        "time_end": "0:08",
        "duration_seconds": 8,
        "direction": "Avatar on screen, direct eye contact, confident tone",
        "dialogue": "Are your videos being IGNORED — while others go viral?",
        "emphasis_words": ["IGNORED"]
      },
      {
        "id": 2,
        "label": "PROBLEM",
        "time_start": "0:08",
        "time_end": "0:20",
        "duration_seconds": 12,
        "direction": "Slow zoom in, serious tone",
        "dialogue": "Most creators spend hours editing — but still end up with content that feels flat, unprofessional, and forgettable. You deserve better results from your hard work.",
        "emphasis_words": ["flat", "unprofessional", "forgettable"]
      },
      {
        "id": 3,
        "label": "SOLUTION REVEAL",
        "time_start": "0:20",
        "time_end": "0:35",
        "duration_seconds": 15,
        "direction": "Energy lifts, brighter lighting, avatar smiles",
        "dialogue": "Introducing the Nexora Video Editing Masterclass — a live, hands-on training event designed to transform the way you edit, produce, and publish video content. In just one day, you will master the techniques that top creators and brands use every single day.",
        "emphasis_words": ["Nexora Video Editing Masterclass", "one day"]
      },
      {
        "id": 4,
        "label": "WHAT YOU WILL LEARN",
        "time_start": "0:35",
        "time_end": "0:55",
        "duration_seconds": 20,
        "direction": "Avatar steps aside — bullet points animate on screen one by one",
        "dialogue": "Here is exactly what you will learn:",
        "curriculum": [
          {
            "topic": "Professional color grading",
            "benefit": "make every frame look cinematic"
          },
          {
            "topic": "AI-powered editing workflows",
            "benefit": "cut your editing time in half"
          },
          {
            "topic": "Motion graphics & text animation",
            "benefit": "keep viewers hooked"
          },
          {
            "topic": "Audio mixing & sound design",
            "benefit": "sound as good as you look"
          },
          {
            "topic": "HeyGen & AI video tools",
            "benefit": "create avatar-led content at scale"
          },
          {
            "topic": "Export & platform optimization",
            "benefit": "perfect files for every channel"
          }
        ]
      },
      {
        "id": 5,
        "label": "SOCIAL PROOF",
        "time_start": "0:55",
        "time_end": "1:05",
        "duration_seconds": 10,
        "direction": "Testimonial quotes appear as animated cards over avatar",
        "dialogue": "Join hundreds of creators, marketers, and business owners who have already leveled up their content game with Nexora training.",
        "emphasis_words": ["hundreds"]
      },
      {
        "id": 6,
        "label": "CALL TO ACTION",
        "time_start": "1:05",
        "time_end": "1:20",
        "duration_seconds": 15,
        "direction": "Bold, urgent tone — countdown timer graphic appears",
        "dialogue": "Seats are limited. This is your moment. Click the link below, register now, and show up ready to create content that DEMANDS attention. We will see you there.",
        "emphasis_words": ["Seats are limited", "DEMANDS attention"]
      }
    ]
  },

